# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000
# Public base URL used to build links to uploaded images
PUBLIC_URL=http://localhost:4000

# ── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=carsale
DB_PASSWORD=carsale
DB_NAME=carsale
# Auto-sync schema from entities. Dev only — use migrations in production.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── Image storage ───────────────────────────────────
# local = save to ./uploads on this server (served at PUBLIC_URL/uploads)
# s3    = any S3-compatible service: AWS S3, Cloudflare R2, DigitalOcean Spaces,
#         Backblaze B2, Wasabi, MinIO
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=s3
S3_BUCKET=
# AWS: e.g. eu-west-2 · R2: auto · Spaces: e.g. lon1 · MinIO: us-east-1
S3_REGION=
# Leave empty for AWS. Otherwise the service's S3 API endpoint, e.g.
#   R2:     https://<account-id>.r2.cloudflarestorage.com
#   Spaces: https://lon1.digitaloceanspaces.com
#   B2:     https://s3.eu-central-003.backblazeb2.com
#   MinIO:  http://localhost:9000   (also set S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public URL that serves the bucket (CDN / CloudFront / R2 public domain).
# Leave empty to use the bucket's default URL.
S3_PUBLIC_URL=
# e.g. public-read, if the bucket isn't public through a bucket policy. Leave empty for R2.
S3_ACL=

# ── Auth ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ── Seed (first admin account) ──────────────────────
SEED_ADMIN_EMAIL=admin@apexselect.co.uk
SEED_ADMIN_PASSWORD=admin123
